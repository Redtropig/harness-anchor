# Auto detect text files and perform LF normalization
* text=auto

# Bash-consumed files must check out LF on every platform (Windows Git Bash
# tolerates CRLF only by MSYS2 leniency; data parsing and byte counts do not).
*.sh text eol=lf
*.sh.tpl text eol=lf
*.mjs text eol=lf
hooks/session-start text eol=lf
hooks/post-tool-use text eol=lf
hooks/stop text eol=lf
hooks/user-prompt-submit text eol=lf
hooks/pre-compact text eol=lf

# The meta-skill is awk-consumed by hooks/session-start (conditional-region
# filter + injection length); pin LF so marker anchors and counts are
# deterministic on every checkout.
skills/using-harness-anchor/SKILL.md text eol=lf

# hooks/run-hook.cmd stays under `* text=auto` ON PURPOSE: the cmd/bash
# polyglot needs platform-native endings on each side (CRLF for cmd.exe on
# Windows checkouts, LF for POSIX sh on Unix checkouts). Do not force eol.
