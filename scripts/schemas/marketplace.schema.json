{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "harness-anchor marketplace.json schema",
  "description": "Reference schema — NOT executed at runtime. validate-manifests.sh uses Python stdlib only.",
  "type": "object",
  "required": ["name", "plugins"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "version"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "source": { "type": "string" },
          "author": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
