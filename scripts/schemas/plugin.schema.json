{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "harness-anchor plugin.json schema",
  "description": "Reference schema — NOT executed at runtime. validate-manifests.sh uses Python stdlib only.",
  "type": "object",
  "required": ["name", "description", "version"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Kebab-case plugin name"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One-line plugin description"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver version (major.minor.patch)"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "license": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
