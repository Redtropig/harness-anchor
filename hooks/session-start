#!/usr/bin/env bash
# SessionStart hook for harness-anchor — full version.
#
# Per plan §"Hook 脚本具体行为", emits a state banner containing:
#   - Active feature (from feature_list.json, "in-progress" entry)
#   - TOC freshness (git-commit anchor algorithm)
#   - Project type (cpp|generic, via scripts/cpp-detect.sh)
#   - State-file budget sentinel (only when a budgeted file exceeds its cap; see step 2d)
#   - Session handoff head (first 10 lines of session-handoff.md)
#   - Compact notice line (only when the hook fired with stdin source=="compact")
#   - Platform line (HA_OS taxonomy: windows (Git-Bash) | darwin | linux)
#   - using-harness-anchor SKILL.md body (the meta-skill, injected slimmed:
#     frontmatter stripped; cpp-only regions gated by cpp-detect; os-<name>
#     regions gated by HA_OS — see step 7)
#
# Hard constraints:
#   - Token budget ≤ 3000 (~ 12000 chars). Skill body truncated to fit.
#   - Defensive: every sub-check fails silently, never aborts the hook.
#   - sub-commands wall-clocked to 3s where possible.
#   - Total watchdog: 5s cap (R1). On timeout, emit nothing, exit 0 (warn-only).
#   - Engine chain (v0.13.0): JSON parsing via scripts/lib/portable.sh
#     (python3→python→py→node→narrow bash). Residual blind spot: with zero
#     engines the active-feature line degrades to "(needs python3 or node)".

set -uo pipefail

# ---- Read stdin BEFORE backgrounding (bg commands get /dev/null stdin) ----
# BOUNDED read: callers that hold stdin open without EOF (nested runners, agent
# harnesses invoking this bare) must not hang the hook — give up after 1s and
# proceed with whatever arrived. Claude Code writes the JSON and closes (EOF in
# ms); a TTY invocation is skipped outright. bash 3.2: read -t takes integers.
HOOK_STDIN=""
if [ ! -t 0 ]; then
    IFS= read -r -d '' -t 1 HOOK_STDIN || true
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SKILL_FILE="${PLUGIN_ROOT}/skills/using-harness-anchor/SKILL.md"

# Platform layer (v0.13.0): JSON engine chain + Windows PATH shield + path
# normalization. Missing lib = broken install → silent no-op (warn-only).
# shellcheck disable=SC1091
. "${PLUGIN_ROOT}/scripts/lib/portable.sh" 2>/dev/null || exit 0
ha_platform_init
# Pre-warm engine detection ONCE in the parent shell so the exported
# HA_JSON_ENGINE is inherited by every $(...) command-substitution below —
# otherwise each ha_json_* call re-probes the engine in its own subshell,
# doubling subprocess spawns (costly on Windows). (v0.13.0)
ha_json_engine_init

# ---- Resolve project root (3-level fallback) ----
# 1) CLAUDE_PROJECT_DIR (set by Claude Code for plugin hooks)
# 2) git toplevel from CWD
# 3) CWD itself
PROJECT_DIR="$(ha_normalize_path "${CLAUDE_PROJECT_DIR:-}")"
if [ -z "$PROJECT_DIR" ] || [ ! -d "$PROJECT_DIR" ]; then
    if git_top=$(git rev-parse --show-toplevel 2>/dev/null); then
        PROJECT_DIR="$git_top"
    else
        PROJECT_DIR="$(pwd)"
    fi
fi

# ---- timeout shim (BSD/macOS may lack `timeout`; try `gtimeout`) ----
to_cmd=""
if   command -v timeout  >/dev/null 2>&1; then to_cmd="timeout 3"
elif command -v gtimeout >/dev/null 2>&1; then to_cmd="gtimeout 3"
fi

# ---- main() — assembles full output, writes to tempfile ----
main() {
    # ---- 0. Hook event source from stdin JSON ("startup"|"clear"|"compact"; empty if absent) ----
    hook_source=""
    if [ -n "$HOOK_STDIN" ]; then
        hook_source=$(printf '%s' "$HOOK_STDIN" | ha_json_field source)
    fi

    # ---- 1. Active feature from feature_list.json ----
    active_feature="none (run /anchor to scaffold)"
    flist="$PROJECT_DIR/feature_list.json"
    if [ -f "$flist" ]; then
        # Engine-parsed; with no JSON engine this is honestly "(needs ...)" —
        # residual blind spot: the ledger may hold an active feature we cannot name.
        # ha_flist_active prints "(no in-progress feature)" itself when the file
        # parses clean with no in-progress entry — identical wording to the old python.
        af=$(ha_flist_active "$flist")
        [ -n "$af" ] || af="(needs python3 or node)"
        active_feature="$af"
    fi

    # ---- 2. Project type via cpp-detect.sh ----
    project_type="generic"
    detect_script="${PLUGIN_ROOT}/scripts/cpp-detect.sh"
    if [ -x "$detect_script" ]; then
        cpp_json=$($to_cmd bash "$detect_script" --target "$PROJECT_DIR" 2>/dev/null || true)
        if [ -n "$cpp_json" ]; then
            # cpp-detect.sh output is our own controlled format — extractable by
            # every engine tier including narrow bash (booleans → true/false).
            # ONE ha_json_fields call, not three ha_json_field: each engine call
            # spawns a subprocess, and on Windows those spawns dominate the hook's
            # wall time (they can push it past the held-open-stdin budget).
            cpp_fields=$(printf '%s' "$cpp_json" | ha_json_fields is_cpp_project build_system standard)
            is_cpp=$(printf '%s\n' "$cpp_fields" | sed -n 1p)
            if [ "$is_cpp" = "true" ]; then
                bs=$(printf '%s\n' "$cpp_fields" | sed -n 2p)
                std=$(printf '%s\n' "$cpp_fields" | sed -n 3p)
                [ -n "$bs" ] || bs="?"
                if [ -n "$std" ] && [ "$std" != "unknown" ]; then
                    project_type="cpp (${bs}, ${std})"
                else
                    project_type="cpp (${bs})"
                fi
            else
                project_type="generic"
            fi
        fi
    fi

    # ---- 2b. C/C++ tooling-not-initialized hint → recommend /cpp-init ----
    # Parallels the /anchor (no feature_list) and /index-project (no TOC) nudges:
    # surface the command that CREATES the missing artifact, at the moment it is missing.
    # Fire only when ALL hold, to avoid nagging:
    #   - this IS a C/C++ project (cpp-detect said so), AND
    #   - it is already anchored (feature_list.json present — /cpp-init refuses without it), AND
    #   - the C/C++ config layer is absent (no .clang-format AND no .clang-tidy).
    # Un-anchored projects already get the /anchor nudge; a project that already has the
    # config doesn't need this (and /cpp-init's overwrite-guard would handle it anyway).
    cpp_init_hint=""
    case "$project_type" in
        cpp*)
            if [ -f "$flist" ] \
               && [ ! -f "$PROJECT_DIR/.clang-format" ] \
               && [ ! -f "$PROJECT_DIR/.clang-tidy" ]; then
                cpp_init_hint="not initialized (no .clang-format/.clang-tidy) — run /cpp-init"
            fi
            ;;
    esac

    # ---- 2c. Golden-rules count (reinforces the feedback flywheel) ----
    golden_rules_line=""
    gr_file="$PROJECT_DIR/golden-rules.md"
    if [ -f "$gr_file" ]; then
        # grep -c already prints "0" on no match (and exits 1); do NOT add `|| printf 0`
        # — that would append a second "0", yielding "00". tr strips the trailing newline.
        gr_count=$(grep -c '^### GR-[0-9]' "$gr_file" 2>/dev/null | tr -cd '0-9')
        [ -z "$gr_count" ] && gr_count=0
        golden_rules_line="${gr_count} rule(s) — /gc scans changed code against them"
    fi

    # ---- 2d. State-file budget sentinel (v0.9.0) — warn-only, never writes ----
    # Observation point (CLAUDE.md hook rule 5):
    #   Y (failure surface): context blowout / attention dilution when oversized state
    #     files get read into a session (the startup ritual reads feature_list.json and
    #     friends every session; opt-in history reads pull progress.md).
    #   X (observed signal): on-disk byte size of the five budgeted state files at
    #     SessionStart, vs fixed caps (progress 64KB · feature_list 32KB ·
    #     golden-rules 8KB · AGENTS 8KB · handoff 4KB).
    #   Coverage: X is a byte-size PROXY — X ⊇ Y does NOT hold. Residual blind spots:
    #     - bytes ≠ actual read cost (the agent may read none, or all, of a large file);
    #     - archive files and PROJECT-TOC.md are unbudgeted here (TOC injection is
    #       adaptively capped in step 8; archives are grep-only by contract);
    #     - mid-session growth is invisible (checked once, at start).
    #   A missing sentinel line is NOT proof of context health.
    state_budget_line=""
    sb_over=""
    for spec in "progress.md:65536" "feature_list.json:32768" "golden-rules.md:8192" "AGENTS.md:8192" "session-handoff.md:4096"; do
        sb_file="${spec%%:*}"
        sb_cap="${spec##*:}"
        sb_path="$PROJECT_DIR/$sb_file"
        [ -f "$sb_path" ] || continue
        sb_size=$(wc -c < "$sb_path" 2>/dev/null | tr -cd '0-9')
        [ -n "$sb_size" ] || continue
        if [ "$sb_size" -gt "$sb_cap" ]; then
            # Caps are exact KiB multiples (floor = exact); the size rounds UP, so a
            # barely-over file (cap+1 bytes) renders 65KB>64KB — never a self-equal
            # 64KB>64KB. The > relation carries the verdict and must stay visibly true.
            sb_entry="${sb_file} $(( (sb_size + 1023) / 1024 ))KB>$((sb_cap / 1024))KB"
            if [ -z "$sb_over" ]; then sb_over="$sb_entry"; else sb_over="${sb_over}, ${sb_entry}"; fi
        fi
    done
    if [ -n "$sb_over" ]; then
        state_budget_line="over budget: ${sb_over} — /session-end offers archival/trim"
    fi

    # ---- 3. TOC freshness (delegated to scripts/toc-freshness.sh, DD5) ----
    toc_file="$PROJECT_DIR/PROJECT-TOC.md"
    freshness_script="${PLUGIN_ROOT}/scripts/toc-freshness.sh"
    toc_status=""
    if [ -x "$freshness_script" ]; then
        raw_status=$($to_cmd bash "$freshness_script" "$PROJECT_DIR" 2>/dev/null || true)
        case "$raw_status" in
            absent*)    toc_status="absent (run /index-project to create PROJECT-TOC.md)" ;;
            no-anchor*) toc_status="present, no valid commit anchor (run /index-project)" ;;
            not-git*)   toc_status="present, not a git repo (cannot verify freshness)" ;;
            fresh*)     toc_status="$raw_status" ;;
            stale*)     # Add "; run /index-project" before the closing paren.
                         toc_status="${raw_status%)}; run /index-project)" ;;
            *)          toc_status="present (freshness unknown)" ;;
        esac
    fi
    if [ -z "$toc_status" ]; then
        toc_status="absent (run /index-project to create PROJECT-TOC.md)"
    fi

    # ---- 4. Session handoff head ----
    handoff_head=""
    handoff_file="$PROJECT_DIR/session-handoff.md"
    if [ -f "$handoff_file" ]; then
        handoff_head=$(head -n 10 "$handoff_file" 2>/dev/null || true)
    fi

    # ---- 5. Assemble banner ----
    # Read version from plugin.json at runtime (DD1 — de-hardcode version).
    plugin_version="unknown"
    if [ -f "${PLUGIN_ROOT}/.claude-plugin/plugin.json" ]; then
        # plugin.json is our own format — the bash tier greps it fine, so the
        # version is real even on an engine-less machine (fixes "vunknown").
        # Feeding the file via stdin redirection avoids passing an MSYS-style
        # path into a native-Windows engine (which cannot open /c/... paths).
        pv=$(ha_json_field version < "${PLUGIN_ROOT}/.claude-plugin/plugin.json")
        [ -n "$pv" ] && plugin_version="$pv"
    fi

    # Platform label: HA_OS is the plugin's own taxonomy (the harness env block
    # says "win32"; this line carries the Git-Bash-baseline semantics and any
    # future finer buckets) and closes the loop for skills' platform/<os>.md
    # pointers. Unknown pre-set values pass through verbatim (override support).
    platform_label="$HA_OS"
    [ "$HA_OS" = "windows" ] && platform_label="windows (Git-Bash)"

    banner="<harness-anchor-state>
Plugin:           harness-anchor v${plugin_version}
Project root:     ${PROJECT_DIR}
Active feature:   ${active_feature}
Project type:     ${project_type}
Platform:         ${platform_label}
TOC freshness:    ${toc_status}"

    # ---- 5b. Compact caution (v0.12.0) — only when this SessionStart fired on a compaction ----
    # Post-compaction, memory-from-recall is the distortion vector; point at disk evidence.
    if [ "$hook_source" = "compact" ]; then
        banner="${banner}
Compact notice:   context was just compacted — memory written from recall is unreliable; reconstruct from on-disk evidence (git diff, test output, progress.md) and state uncertainty rather than guess."
    fi

    if [ -n "$golden_rules_line" ]; then
        banner="${banner}
Golden rules:     ${golden_rules_line}"
    fi

    if [ -n "$state_budget_line" ]; then
        banner="${banner}
State budget:     ${state_budget_line}"
    fi

    if [ -n "$cpp_init_hint" ]; then
        banner="${banner}
C/C++ setup:      ${cpp_init_hint}"
    fi

    if [ -n "$handoff_head" ]; then
        banner="${banner}
Last session handoff (first 10 lines):
${handoff_head}"
    else
        banner="${banner}
Last session handoff: (no session-handoff.md — run /anchor or /session-end)"
    fi

    banner="${banner}
</harness-anchor-state>

"

    # ---- 6. Read PROJECT-TOC.md navigation sections (Tier 1) ----
    # Extract both the "## Files" (per-file leaves) and "## Directory map" (forest) sections.
    # The ADAPTIVE choice of which to inject — given the token budget — happens in step 8.
    toc_files_section=""
    toc_dirmap_section=""
    if [ -f "$toc_file" ]; then
        # Lines between a "## X" header and the next "## " header (or EOF), blanks trimmed.
        toc_files_section=$(awk '/^## Files/{flag=1; next} /^## /{flag=0} flag' "$toc_file" 2>/dev/null || true)
        toc_files_section=$(printf '%s' "$toc_files_section" | awk 'NF{p=1} p' | awk 'BEGIN{lines=""} {lines=lines $0 "\n"} END{sub(/\n+$/, "", lines); print lines}')
        toc_dirmap_section=$(awk '/^## Directory map/{flag=1; next} /^## /{flag=0} flag' "$toc_file" 2>/dev/null || true)
        toc_dirmap_section=$(printf '%s' "$toc_dirmap_section" | awk 'NF{p=1} p' | awk 'BEGIN{lines=""} {lines=lines $0 "\n"} END{sub(/\n+$/, "", lines); print lines}')
    fi

    # ---- 7. Read + slim the meta-skill body ----
    # Injected form = a pure filter of the file: strip the YAML frontmatter
    # (metadata for the skill lister, not the session), the <!-- cpp-only -->
    # regions in non-C/C++ projects (invariant #5 — cpp-detect gates C/C++
    # content), and any <!-- os-<name> --> region whose name is not the current
    # HA_OS (v0.14.0 — unknown names drop too: fail-slim, never fail-fat).
    # Marker lines are never injected. BOTH families are FLAT by contract —
    # this single-boolean filter cannot parse nesting; validate-anchor [7/12]
    # rejects nested/misordered/mismatched markers at authoring time. The file
    # itself stays intact for the Skill-tool path.
    skill_content=""
    if [ -f "$SKILL_FILE" ]; then
        is_cpp=0
        case "$project_type" in cpp*) is_cpp=1 ;; esac
        skill_content="$(awk -v cpp="$is_cpp" -v os="$HA_OS" '
            NR==1 && /^---$/          { fm=1; next }
            fm && /^---$/             { fm=0; next }
            fm                        { next }
            /<!-- cpp-only-start -->/ { if (!cpp) skip=1; next }
            /<!-- cpp-only-end -->/   { skip=0; next }
            /<!-- os-[a-z0-9]+-start -->/ { n=$0; sub(/.*<!-- os-/,"",n); sub(/-start -->.*/,"",n); if (n != os) skip=1; next }
            /<!-- os-[a-z0-9]+-end -->/   { skip=0; next }
            skip                      { next }
            { print }
        ' "$SKILL_FILE")"
    else
        skill_content="(using-harness-anchor SKILL.md missing — plugin install incomplete)"
    fi

    # ---- 8. Combine + token budget hard cap (≤ ~3000 tokens ≈ 12000 chars) ----
    # Priority: banner (always full) → skill body → TOC (adaptive; dropped first).
    MAX_CHARS=12000
    banner_len=${#banner}
    skill_len=${#skill_content}

    # Budget for the TOC block = remaining after banner + skill + 200-char marker buffer.
    toc_budget=$((MAX_CHARS - banner_len - skill_len - 200))

    # ---- Adaptive Tier-1 TOC injection ----
    #  (a) full "## Files" fits          → inject it (small-repo UX unchanged)
    #  (b) else "## Directory map" fits   → inject the forest view + pointer
    #  (c) even the map is too big        → shallowest dirs first, truncated + pointer
    #  (d) no map present (old TOC)       → legacy alphabetical Files truncation
    toc_block=""
    if [ "$toc_budget" -ge 250 ]; then
        files_block=""
        if [ -n "$toc_files_section" ]; then
            files_block="<project-toc>
${toc_files_section}
</project-toc>

"
        fi

        if [ -n "$files_block" ] && [ "${#files_block}" -le "$toc_budget" ]; then
            toc_block="$files_block"                                    # (a)
        elif [ -n "$toc_dirmap_section" ]; then
            dirmap_block="<project-toc>
${toc_dirmap_section}
<see PROJECT-TOC.md ## Files for the full per-file index>
</project-toc>

"
            if [ "${#dirmap_block}" -le "$toc_budget" ]; then
                toc_block="$dirmap_block"                              # (b)
            else
                # (c) shallowest dirs first (sort by '/'-depth, stable), then truncate.
                shallow=$(printf '%s\n' "$toc_dirmap_section" \
                    | awk '{ d=gsub(/\//,"/"); printf "%d\t%s\n", d, $0 }' \
                    | sort -n -s -k1,1 | cut -f2-)
                shallow="${shallow:0:$toc_budget}"
                shallow="${shallow%$'\n'*}"
                toc_block="<project-toc>
${shallow}
<see PROJECT-TOC.md ## Directory map for the full map>
</project-toc>

"
            fi
        elif [ -n "$toc_files_section" ]; then
            # (d) legacy fallback — no Directory map in this (old) TOC.
            truncated_files="${toc_files_section:0:$toc_budget}"
            truncated_files="${truncated_files%$'\n'*}"
            toc_block="<project-toc>
${truncated_files}
<see PROJECT-TOC.md for full index>
</project-toc>

"
        fi
    fi

    combined="${banner}${toc_block}${skill_content}"

    # Normalize to LF: SKILL.md / PROJECT-TOC.md may check out CRLF on Windows
    # (they are not eol=lf-pinned), and each stray \r both wastes injection budget
    # (invariant #2 — the at-scale count blew past 12000 on Windows purely on \r)
    # and is noise to the model. Strip so count + payload are platform-independent.
    combined="${combined//$'\r'/}"

    # Final safety: if skill body itself is enormous, truncate it.
    if [ "${#combined}" -gt "$MAX_CHARS" ]; then
        marker="

<truncated — see ${SKILL_FILE} for full content>"
        marker_len=${#marker}
        skill_budget=$((MAX_CHARS - banner_len - ${#toc_block} - marker_len))
        if [ "$skill_budget" -gt 0 ]; then
            combined="${banner}${toc_block}${skill_content:0:$skill_budget}${marker}"
        else
            # Worst-case: even banner+TOC alone exceeds cap. Emit raw cap.
            combined="${combined:0:$MAX_CHARS}"
        fi
    fi

    # ---- 9. JSON-escape via the shared engine chain (scripts/lib/portable.sh) ----
    # ha_json_escape uses python/node json.dumps (O(n)); its pure-bash last resort
    # is the same quadratic ${var//} escaper as before (engines cover the common case).
    context=$(printf '%s' "$combined" | ha_json_escape)

    # ---- 10. Emit to stdout (parent captures via redirect for R1) ----
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"
}

# ---- R1: Total watchdog (5s cap, tempfile-guarded) ----
# Run main() with stdout redirected to a tempfile; if it exceeds 5s, kill it
# and emit nothing. Only emit the tempfile if main() exited cleanly (rc=0).
# This avoids the partial-JSON pitfall: a mid-write kill would produce truncated
# JSON, so we buffer to file and only release the full output on success.
#
# Both kills are SIGKILL, and the watchdog's stdio is detached — measured on
# macOS bash 3.2: a subshell blocked on `sleep` DEFERS SIGTERM until the sleep
# completes, which (a) made the parent's `wait $watchdog_pid` burn the whole 5s
# window on every run (main finished in ~0.4s; consumers saw ~5s wall), and
# (b) meant a genuinely runaway main was never actually killed on that bash —
# the deferred TERM aborts the subshell before its `kill` line runs. SIGKILL
# cannot be deferred; the stdio detach keeps the sleeping subshell from holding
# a command-substitution consumer's pipe open for the same 5s.
OUTPUT_FILE=$(mktemp)
main > "$OUTPUT_FILE" 2>/dev/null &
main_pid=$!

# Watchdog: hard-kill main after 5 seconds
( sleep 5; kill -9 $main_pid 2>/dev/null ) >/dev/null 2>&1 &
watchdog_pid=$!

wait $main_pid 2>/dev/null
main_rc=$?
kill -9 $watchdog_pid 2>/dev/null
wait $watchdog_pid 2>/dev/null

if [ "$main_rc" -eq 0 ] && [ -f "$OUTPUT_FILE" ] && [ -s "$OUTPUT_FILE" ]; then
    cat "$OUTPUT_FILE"
fi
rm -f "$OUTPUT_FILE" 2>/dev/null

exit 0
