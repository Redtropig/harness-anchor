#!/usr/bin/env bash
# UserPromptSubmit hook for harness-anchor.
#
# Detects scope-jump phrases in the user's prompt. If an active feature exists
# in feature_list.json, surface a warning so the agent can confirm with user
# before pivoting.
#
# Warn-only — never blocks the user's prompt.

set -uo pipefail

# Read stdin (the user's prompt arrives as JSON with a 'prompt' field).
input="$(cat 2>/dev/null || true)"
if [ -z "$input" ]; then
    exit 0
fi

# Platform layer (v0.13.0), sourced AFTER the stdin read so nothing can disturb it.
# Pre-warm the engine once so the exported HA_JSON_ENGINE is inherited by $(...) below.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
. "${SCRIPT_DIR}/../scripts/lib/portable.sh" 2>/dev/null || exit 0
ha_platform_init
ha_json_engine_init

# Engine-chained; narrow bash tier flattens newlines (keyword scan unaffected).
# Residual (v0.13.0): (a) with zero engines AND a prompt the bash tier cannot
# extract, the hook skips — silence is not proof the prompt was scanned;
# (b) the 也-heuristic below uses ${#prompt_text}, which counts BYTES under a
# C/POSIX locale but CHARACTERS under UTF-8 — Git Bash's locale may differ from
# macOS, shifting the <80 threshold for CJK prompts (accepted: scope-jump
# detection is a warn-only heuristic, not a correctness gate).
prompt_text=$(printf '%s' "$input" | ha_json_field prompt)

if [ -z "$prompt_text" ]; then
    exit 0
fi

# Find project root (fixed-point walk-up: terminates on /, C:/, ., UNC roots).
project_root=$(ha_find_project_root "$(pwd)" || true)

if [ -z "$project_root" ]; then
    exit 0
fi

# Identify scope-jump keywords (中英文混合).
# Case-insensitive; whole-phrase or substring match.
lower=$(printf '%s' "$prompt_text" | tr '[:upper:]' '[:lower:]')

scope_jump=0
for kw in "顺便" "另外" "再加" "还要" "by the way" "btw" " also " "while you're at it" "while you are at it" "let's also" "lets also"; do
    case "$lower" in
        *"$kw"*) scope_jump=1; break ;;
    esac
done

# Special-case the bare Chinese 也 — it's very common as a particle, so we require
# it to be followed by an action verb-like context. Heuristic: skip 也 alone unless
# the prompt is short and starts with it.
if [ "$scope_jump" -eq 0 ]; then
    short_len=${#prompt_text}
    if [ "$short_len" -lt 80 ] && printf '%s' "$prompt_text" | grep -q "^.\{0,5\}也"; then
        scope_jump=1
    fi
fi

if [ "$scope_jump" -eq 0 ]; then
    exit 0
fi

# Check for active feature.
active=$(ha_flist_active "$project_root/feature_list.json")
case "$active" in "(no in-progress feature)") active="" ;; esac

if [ -z "$active" ]; then
    exit 0
fi

msg="Scope-jump phrasing detected. Active feature: $active. The new request may be out of scope. Confirm with the user whether to (a) finish active feature first, (b) pause and switch, or (c) record as a planned feature in feature_list.json."

escaped=$(printf '%s' "$msg" | ha_json_escape)

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "UserPromptSubmit",\n    "additionalContext": "<harness-anchor scope-check>\\n%s\\n</harness-anchor scope-check>"\n  }\n}\n' "$escaped"

exit 0
