#!/usr/bin/env bash
# PostToolUse hook for harness-anchor.
#
# Triggered after Edit|Write tool calls. Warn-only — never blocks.
# Output (when warning): JSON additionalContext for next-turn injection.
#
# Phase 3: generic framework + regression-warn check.
# Phase 4 adds C/C++ specific clang-tidy invocation.
#
# Hard constraints:
#   - Must complete in <5 seconds (total watchdog, R1)
#   - Silent on missing tools (warn-only philosophy, never pollute context with infra errors)
#   - Never emits permissionDecision/stopReason/block
#
# Observation point — Check 2, clang-tidy (modified in v0.8.0; CLAUDE.md hook rule 5):
#   Y (failure surface): lint-detectable defects / style violations in the just-edited
#     C/C++ file — plus the fidelity failure this revision targets: the agent ACTING on
#     diagnostics that are false because the TU never parsed.
#   X (observed signal): clang-tidy warning/error lines for that one file, resolved via
#     compile_commands.json (+ SDK sysroot via xcrun on Darwin).
#   Coverage: X ⊇ Y does NOT hold universally — X is trustworthy only when the TU parses.
#   Residual blind spots (a quiet hook is NOT proof of lint-clean):
#     - parse failure (any clang-diagnostic-error): diagnostics withheld, ONE notice line only;
#     - >20 findings truncated; 5s watchdog kill or missing clang-tidy/compile_commands → silent skip;
#     - authoritative lint verdicts come from the project lint script (scripts/lint.sh) or /verify.
#     - no JSON engine at all (python3/python/py/node): the ledger-derived checks (1, 1b, 1c)
#       skip silently — quietness is not proof they ran (v0.13.0, scripts/lib/portable.sh).
#   (Check 1c's observation point is documented at the check itself, lines ~160 below.)

set -uo pipefail   # no -e: a single check failure should not abort other checks

# Platform layer (v0.13.0): engine chain + Windows PATH shield + normalization.
# Missing lib = broken install → silent no-op (warn-only). The engine pre-warm
# moved INTO the slow lane (v0.15.0): probing spawns 1-4 subprocesses, and the
# all-tool fast lane must stay spawn-free on its non-nudge path.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
. "${SCRIPT_DIR}/../scripts/lib/portable.sh" 2>/dev/null || exit 0
ha_platform_init

# Context-fill thresholds (bytes of transcript JSONL; pulse watermark — Check 1d
# migrated into the all-tool fast lane in v0.15.0). Transcript bytes are a COARSE
# proxy for context tokens (tool-result share varies per session):
#   T1 FLUSH ≈ a long session nearing its first auto-compaction — flush durable memory;
#   T2 RESET ≈ deep fill — prefer /session-end + a fresh session over auto-compaction.
# Warn-only + warn-once per stage: a miscalibration costs at most one extra/late line.
FLUSH_THRESHOLD_BYTES=6291456
RESET_THRESHOLD_BYTES=8388608
# Pulse detector tuning (docs/troubleshooting.md #13). PULSE_ERR_N must stay
# <= PULSE_DUP_N (both read the same PULSE_DUP_N-line window).
PULSE_DUP_N=3
PULSE_ERR_N=3
PULSE_COOLDOWN=10
PULSE_SELFCHECK_EVERY=25

# ---- Read stdin BEFORE backgrounding (bg commands get /dev/null stdin) ----
# BOUNDED read (1s; same hazard class as session-start): callers holding stdin
# open without EOF must not hang the hook; a TTY invocation is skipped outright.
# Claude Code writes the event JSON and closes — EOF arrives in ms.
INPUT_FILE=$(mktemp)
HOOK_STDIN=""
if [ ! -t 0 ]; then
    IFS= read -r -d '' -t 1 HOOK_STDIN || true
fi
printf '%s' "$HOOK_STDIN" > "$INPUT_FILE" 2>/dev/null || true

# ---- Pulse fast lane (v0.15.0) ----
# Observation point (CLAUDE.md hook rule 5):
#   Y (failure surface): agent churn — repeated identical calls, retry storms on
#     a failing tool, context overfill, silent scope drift — burning tokens/time.
#   X (observed signal): per-session sliding window of (tool, input-hash, err)
#     tuples in .harness-anchor/pulse-<sid>.tsv + transcript byte size.
#   Coverage: X ⊉ Y. Residual blind spots (silence is NOT proof of health):
#     - near-duplicate loops (input varied slightly each try) hash differently —
#       only EXACT repeats are caught;
#     - err is a response-prefix heuristic ("is_error":true / "success":false /
#       "interrupted":true within the first 400 bytes) — other failure shapes pass;
#     - unanchored projects (no feature_list.json above cwd/file_path): no pulse;
#     - the hash segment ends at the first ,"tool_response" byte sequence —
#       payload containing that literal truncates the hash (identical inputs still
#       match; distinct inputs sharing the prefix may collide);
#     - a genuine loop inside the PULSE_COOLDOWN window stays un-nudged (noise
#       control trade-off);
#     - subagent attribution: finalized in the v0.15.0 acceptance pass (Task 7).
pulse_run() {
    [ -n "$session_id" ] && [ -n "$pulse_root" ] || return 0
    local pdir pfile lastf prev_line prev_seq inhash rseg err tbytes w last_nudge dup_n err_n
    pdir="$pulse_root/.harness-anchor"
    pfile="$pdir/pulse-$session_id.tsv"
    lastf="$pdir/pulse-$session_id.last"
    mkdir -p "$pdir" 2>/dev/null || return 0

    prev_line=$(tail -n 1 "$pfile" 2>/dev/null || true)
    prev_seq="${prev_line%%$'\t'*}"
    case "$prev_seq" in ''|*[!0-9]*) prev_seq=0 ;; esac
    seq=$((prev_seq + 1))

    # Input hash: bytes between "tool_input": and the first ,"tool_response".
    # The payload is one physical line (JSON escapes newlines); a pretty-printed
    # payload just yields inhash=0 -> the dup detector goes inert (fail-safe).
    inhash=$(printf '%s' "$input" | awk '{
        i = index($0, "\"tool_input\":"); if (i == 0) { print 0; exit }
        s = substr($0, i + 13)
        j = index(s, ",\"tool_response\""); if (j > 0) s = substr(s, 1, j - 1)
        print substr(s, 1, 4096) }' | cksum 2>/dev/null)
    inhash="${inhash%% *}"
    case "$inhash" in ''|*[!0-9]*) inhash=0 ;; esac

    rseg=$(printf '%s' "$input" | awk '{
        i = index($0, "\"tool_response\":"); if (i == 0) exit
        print substr($0, i + 16, 400) }')
    err=0
    case "$rseg" in
        *'"is_error":true'*|*'"success":false'*|*'"interrupted":true'*) err=1 ;;
    esac

    tbytes=0
    if [ -n "$transcript_path" ] && [ -f "$transcript_path" ]; then
        tbytes=$(wc -c < "$transcript_path" 2>/dev/null | tr -cd '0-9')
        [ -n "$tbytes" ] || tbytes=0
    fi

    printf '%s\t%s\t%s\t%s\t%s\n' "$seq" "$tool_name" "$inhash" "$err" "$tbytes" >> "$pfile" 2>/dev/null || return 0

    # Maintenance: trim the window file; opportunistically drop stale sessions.
    if [ $((seq % 50)) -eq 0 ]; then
        tail -n 100 "$pfile" > "$pfile.tmp" 2>/dev/null && mv "$pfile.tmp" "$pfile" 2>/dev/null
        find "$pdir" -maxdepth 1 -name 'pulse-*' -mtime +7 -exec rm -f {} \; 2>/dev/null || true
    fi

    # Cooldown: after any pulse nudge, hold all detectors for PULSE_COOLDOWN calls.
    last_nudge=$(tr -cd '0-9' < "$lastf" 2>/dev/null || true)
    [ -n "$last_nudge" ] || last_nudge=0
    if [ "$last_nudge" -gt 0 ] && [ $((seq - last_nudge)) -lt "$PULSE_COOLDOWN" ]; then
        return 0
    fi

    # Detectors — priority order, at most ONE nudge per invocation.
    w=$(tail -n "$PULSE_DUP_N" "$pfile" 2>/dev/null || true)
    if [ "$(printf '%s\n' "$w" | grep -c .)" -eq "$PULSE_DUP_N" ]; then
        if [ "$inhash" != "0" ]; then
            dup_n=$(printf '%s\n' "$w" | awk -F'\t' -v t="$tool_name" -v h="$inhash" '$2==t && $3==h {c++} END {print c+0}')
            if [ "$dup_n" -eq "$PULSE_DUP_N" ]; then
                PULSE_NUDGE="Pulse: '$tool_name' called ${PULSE_DUP_N}x with identical input. Repeating an unchanged call won't change the outcome — change the input or approach; if the tool/API itself is unclear, follow docs-lookup."
            fi
        fi
        if [ -z "$PULSE_NUDGE" ]; then
            err_n=$(printf '%s\n' "$w" | awk -F'\t' -v t="$tool_name" '$2==t && $4==1 {c++} END {print c+0}')
            if [ "$err_n" -eq "$PULSE_ERR_N" ]; then
                PULSE_NUDGE="Pulse: '$tool_name' failed ${PULSE_ERR_N}x in a row. Stop retrying as-is — diagnose evidence-first (self-correction-loop); for unfamiliar errors follow docs-lookup."
            fi
        fi
    fi

    # (Task 2 inserts the two-stage watermark here.)
    # (Task 3 inserts the periodic selfcheck here.)
    return 0
}

# ---- main() — all logic wrapped for R1 total watchdog ----
main() {
    # Read pre-captured stdin from tempfile.
    input="$(cat "$INPUT_FILE" 2>/dev/null || true)"
    [ -n "$input" ] || return 0

    # ---- Fast lane: pure-bash envelope extraction (v0.15.0 — NO engine spawn) ----
    # Claude Code serializes the envelope (session_id, transcript_path, cwd,
    # hook_event_name, tool_name) BEFORE tool_input, so a 1 KiB head slice holds
    # them all and payload content cannot spoof them. Empty extraction -> the
    # dependent check skips (fail-safe = silence).
    head_slice="${input:0:1024}"
    fastfield() { # $1 = key; echoes the string value of "key":"value" from head_slice
        case "$head_slice" in
            *"\"$1\":\""*) local v="${head_slice#*\"$1\":\"}"; printf '%s' "${v%%\"*}" ;;
        esac
    }
    tool_name="$(fastfield tool_name | tr -cd 'A-Za-z0-9_-')"
    tool_name="${tool_name:0:64}"
    session_id="$(fastfield session_id | tr -cd 'A-Za-z0-9._-')"
    transcript_path="$(fastfield transcript_path)"
    transcript_path="$(ha_normalize_path "${transcript_path//\\\\/\\}")"
    hook_cwd="$(fastfield cwd)"
    hook_cwd="$(ha_normalize_path "${hook_cwd//\\\\/\\}")"

    # Pulse project root: cwd, else the edited file's directory (legacy payloads
    # and contract fixtures omit cwd), else no pulse.
    pulse_root=""
    [ -n "$hook_cwd" ] && pulse_root=$(ha_find_project_root "$hook_cwd" || true)
    if [ -z "$pulse_root" ]; then
        fp_fast="$(fastfield file_path)"
        fp_fast="$(ha_normalize_path "${fp_fast//\\\\/\\}")"
        [ -n "$fp_fast" ] && pulse_root=$(ha_find_project_root "$(dirname "$fp_fast")" || true)
    fi

    PULSE_NUDGE=""
    seq=0
    [ -n "$tool_name" ] && pulse_run

    # ---- Lane dispatch: Edit|Write (and legacy empty tool_name) continue into
    # the slow lane; every other tool is fast-lane only. ----
    case "$tool_name" in
        Edit|Write|"") : ;;
        *)
            if [ -n "$PULSE_NUDGE" ]; then
                printf '%s' "$seq" > "$pulse_root/.harness-anchor/pulse-$session_id.last" 2>/dev/null || true
                printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PostToolUse",\n    "additionalContext": "<harness-anchor PostToolUse>\\n%s\\n</harness-anchor PostToolUse>"\n  }\n}\n' "$PULSE_NUDGE"
            fi
            return 0
            ;;
    esac

    # ---- Slow lane (Edit|Write) — pre-warm the engine ONCE so the exported
    # HA_JSON_ENGINE is inherited by every $(...) below (v0.15.0: moved here from
    # the script top so non-Edit tools never pay the 1-4 probe subprocesses). ----
    ha_json_engine_init

    # Extract file_path field (very narrow JSON parse — avoid jq dependency).
    file_path=$(printf '%s' "$input" | ha_json_field tool_input.file_path)
    file_path=$(ha_normalize_path "$file_path")

    # No file path → nothing to check.
    if [ -z "$file_path" ]; then
        return 0
    fi

    # Extract tool_name (Check 1c) + transcript_path/session_id (Check 1d) in ONE parse
    # (keeps the per-event python3 process count unchanged).
    tool_name=""
    transcript_path=""
    session_id=""
    if [ -n "$input" ]; then
        tn_tp_sid=$(printf '%s' "$input" | ha_json_fields tool_name transcript_path session_id)
        tool_name=$(printf '%s\n' "$tn_tp_sid" | sed -n '1p')
        transcript_path=$(ha_normalize_path "$(printf '%s\n' "$tn_tp_sid" | sed -n '2p')")
        # session_id feeds a marker FILENAME — strip to a safe charset.
        session_id=$(printf '%s\n' "$tn_tp_sid" | sed -n '3p' | tr -cd 'A-Za-z0-9._-')
    fi

    # Find project root (where feature_list.json lives) — fixed-point walk-up
    # from file_path (terminates on /, C:/, ., UNC roots; ≤64 levels). The old
    # `!= "/"` loop never terminated on a drive-letter path and burned the 5s
    # watchdog on every Windows edit.
    project_root=$(ha_find_project_root "$(dirname "$file_path")" || true)

    # No anchored project → nothing to check.
    if [ -z "$project_root" ]; then
        return 0
    fi

    warnings=()

    # ---- Check 1: regression-warn ----
    # If the edited file is referenced in evidence.artifacts of a feature marked
    # status='pass', that's a regression risk. Surface a one-line warning.
    rel_path="${file_path#"$project_root"/}"
    regression=""
    case "$HA_JSON_ENGINE" in
        python3|python|py)
            # shellcheck disable=SC2086
            regression=$($HA_PY - "$project_root/feature_list.json" "$rel_path" <<'PY' 2>/dev/null || true
import json, sys, os
flist_path, rel = sys.argv[1], sys.argv[2]
try:
    with open(flist_path) as f:
        data = json.load(f)
    for feat in data.get('features', []):
        if feat.get('status') != 'pass':
            continue
        ev = feat.get('evidence') or {}
        artifacts = ev.get('artifacts') or []
        # naive: warn if rel path appears as a substring of any artifact path
        # OR if it's a source file likely to invalidate the proof
        if any(rel in a for a in artifacts):
            print(f"Regression risk: file '{rel}' is referenced as evidence for passed feature '{feat['id']}'. Re-verify before continuing.")
            sys.exit(0)
        # also warn if changing source while a feature passed without re-verify
        # — rough heuristic: any source file change after pass
        if rel.endswith(('.c','.cc','.cpp','.cxx','.h','.hpp','.ts','.js','.py','.rs','.go')):
            print(f"Note: feature '{feat['id']}' is marked pass. Source change may invalidate its evidence. Consider re-running /verify.")
            sys.exit(0)
except Exception:
    pass
PY
) ;;
        node)
            regression=$(node -e '
const fs = require("fs");
let data; try { data = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch (e) { process.exit(0); }
const rel = process.argv[2];
const exts = [".c",".cc",".cpp",".cxx",".h",".hpp",".ts",".js",".py",".rs",".go"];
for (const feat of (data.features || [])) {
    if (!feat || feat.status !== "pass") continue;
    const artifacts = (feat.evidence && feat.evidence.artifacts) || [];
    if (artifacts.some(a => typeof a === "string" && a.includes(rel))) {
        console.log("Regression risk: file '" + rel + "' is referenced as evidence for passed feature '" + feat.id + "'. Re-verify before continuing.");
        process.exit(0);
    }
    if (exts.some(e => rel.endsWith(e))) {
        console.log("Note: feature '" + feat.id + "' is marked pass. Source change may invalidate its evidence. Consider re-running /verify.");
        process.exit(0);
    }
}
' "$project_root/feature_list.json" "$rel_path" 2>/dev/null || true) ;;
    esac

    if [ -n "$regression" ]; then
        warnings+=("$regression")
    fi

    # ---- Check 1b: duplicate feature id (only when the ledger itself was written) ----
    # Feature ids are the lookup key for status/evidence updates (/verify flips "the" feature
    # by id), and JSON Schema draft-07 cannot express per-field uniqueness — so a collision is
    # invisible to the schema. Warn-only safety net behind the pre-write guidance in
    # feature-state-keeper. Parses the just-written file; fail-silent on a transient parse error.
    if [ "$(basename "$file_path")" = "feature_list.json" ]; then
        dup_warn=""
        case "$HA_JSON_ENGINE" in
            python3|python|py)
                # shellcheck disable=SC2086
                dup_warn=$($HA_PY - "$file_path" <<'PY' 2>/dev/null || true
import json, sys, re
try:
    with open(sys.argv[1]) as fh:
        data = json.load(fh)
    ids = [f.get('id') for f in data.get('features', []) if isinstance(f.get('id'), str)]
    counts = {}
    for i in ids:
        counts[i] = counts.get(i, 0) + 1
    dups = {i: n for i, n in counts.items() if n > 1}
    if dups:
        existing = set(ids)
        def suggest(base):
            m = re.match(r'^(.*?)-(\d+)$', base)
            stem = m.group(1) if m else base
            n = int(m.group(2)) + 1 if m else 2
            while '%s-%d' % (stem, n) in existing:
                n += 1
            return '%s-%d' % (stem, n)
        listed = ", ".join("'%s' (x%d)" % (i, n) for i, n in dups.items())
        first = sorted(dups)[0]
        print("Duplicate feature id(s) in feature_list.json: %s. Feature ids must be unique (they key status/evidence updates). Rename the newer entry to a unique id, e.g. '%s'." % (listed, suggest(first)))
except Exception:
    pass
PY
) ;;
            node)
                dup_warn=$(node -e '
const fs = require("fs");
let data; try { data = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch (e) { process.exit(0); }
const ids = (data.features || []).map(f => f && f.id).filter(i => typeof i === "string");
const counts = {};
for (const i of ids) counts[i] = (counts[i] || 0) + 1;
const dups = {};
for (const [i, n] of Object.entries(counts)) if (n > 1) dups[i] = n;
if (Object.keys(dups).length) {
    const existing = new Set(ids);
    const suggest = (base) => {
        const m = base.match(/^(.*?)-(\d+)$/);
        const stem = m ? m[1] : base;
        let n = m ? parseInt(m[2], 10) + 1 : 2;
        while (existing.has(stem + "-" + n)) n++;
        return stem + "-" + n;
    };
    const listed = Object.entries(dups).map(([i, n]) => "'" + i + "' (x" + n + ")").join(", ");
    const first = Object.keys(dups).sort()[0];
    console.log("Duplicate feature id(s) in feature_list.json: " + listed + ". Feature ids must be unique (they key status/evidence updates). Rename the newer entry to a unique id, e.g. '" + suggest(first) + "'.");
}
' "$file_path" 2>/dev/null || true) ;;
        esac
        if [ -n "$dup_warn" ]; then
            warnings+=("$dup_warn")
        fi
    fi

    # ---- Check 1c: agent-initiated scope expansion (new code module mid-feature) ----
    # The UserPromptSubmit guardrail observes only the *prompt*; it is blind to scope the agent
    # grows on its own (a new module, a rewrite) with no trigger phrase. This is the action-side
    # observation point (issue #6 -- "observation-point mismatch"). Warn-only nudge, fires standalone.
    #
    # Coverage (signal observed): a brand-new code module created via Write while a feature is
    #   in-progress. Precision: edits/overwrites/test+doc files/git-ignored files never trigger,
    #   so legitimate in-feature edits stay silent by construction.
    # Residual blind spots (do NOT read silence as proof of in-scope):
    #   - scope spread across edits to existing files (churn);
    #   - in-file structural growth (a class gaining template params / new public types);
    #   - new scope introduced only in test/doc files;
    #   - creation via a tool other than Write (PostToolUse fires only on Edit|Write — a file
    #     produced by a Bash command never reaches this check);
    #   - non-git projects (the "new = untracked" signal needs git).
    if [ "$tool_name" = "Write" ] && command -v git >/dev/null 2>&1; then
        case "$file_path" in
            *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx|*.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.py|*.rs|*.go|*.java|*.kt|*.rb|*.swift|*.scala|*.cs|*.php)
                # Deny-list: a new test/doc/build file is good behavior, not creep. Slash-bounded
                # so "mytests/" or "docs_helper.py" are NOT mistaken for "tests/" or "docs/".
                case "/$rel_path/" in
                    */tests/*|*/test/*|*/spec/*|*/specs/*|*/__tests__/*|*/__mocks__/*|*/docs/*|*/doc/*|*/examples/*|*/example/*|*/samples/*|*/build/*|*/builddir/*|*/dist/*|*/out/*|*/target/*|*/vendor/*|*/third_party/*|*/node_modules/*|*/.git/*|*/.build/*|*/venv/*|*/.venv/*)
                        : ;;  # in a deny-listed dir -> skip
                    *)
                        if git -C "$project_root" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
                           && ! git -C "$project_root" ls-files --error-unmatch -- "$rel_path" >/dev/null 2>&1 \
                           && ! git -C "$project_root" check-ignore -q -- "$rel_path" 2>/dev/null; then
                            # New, untracked, non-ignored code module. Warn only if a feature is in-progress.
                            active_feat=$(ha_flist_active "$project_root/feature_list.json")
                            case "$active_feat" in "(no in-progress feature)") active_feat="" ;; esac
                            if [ -n "$active_feat" ]; then
                                warnings+=("New module '$rel_path' was created while feature '$active_feat' is in-progress. If it belongs to that feature, ignore this. If it's new scope, record it as a 'planned' feature first (feature-state-keeper) and confirm direction with the user before continuing.")
                            fi
                        fi
                        ;;
                esac
                ;;
        esac
    fi

    # ---- Check 1d: context-fill flush reminder (v0.12.0) ----
    # Observation point (CLAUDE.md hook rule 5):
    #   Y (failure surface): durable memory (golden-rule lessons, decisions, milestones)
    #     lost or distorted because its write was deferred past a context compaction.
    #   X (observed signal): transcript file size crossing FLUSH_THRESHOLD_BYTES.
    #   Coverage: X ⊉ Y. Residual blind spots (silence is NOT proof nothing needs flushing):
    #     - bytes ≠ tokens (tool-result share varies), and the transcript file is written
    #       asynchronously (docs: may lag the in-memory conversation) → may fire early or late;
    #     - warn-once per session: the transcript keeps growing after the first compaction,
    #       so only the FIRST approach is guarded (the highest-value one);
    #     - subagent transcripts are separate files — their fill is invisible here;
    #     - fires only on Edit|Write inside an ANCHORED project (the hook's global gate) —
    #       sessions editing elsewhere fill context unobserved;
    #     - unwritable .harness-anchor/ → reminder suppressed (fail-silent beats repeat-nagging).
    if [ -n "$transcript_path" ] && [ -n "$session_id" ] && [ -f "$transcript_path" ]; then
        flush_marker="$project_root/.harness-anchor/flush-warned-$session_id"
        if [ ! -f "$flush_marker" ]; then
            t_size=$(wc -c < "$transcript_path" 2>/dev/null | tr -cd '0-9')
            if [ -n "$t_size" ] && [ "$t_size" -gt "$FLUSH_THRESHOLD_BYTES" ]; then
                mkdir -p "$project_root/.harness-anchor" 2>/dev/null || true
                if : > "$flush_marker" 2>/dev/null; then
                    warnings+=("Context is filling (transcript ≈$(( t_size / 1048576 )) MB). If any durable memory is still chat-only — golden-rule stubs, feature status, progress milestones — flush it to disk now while details are exact (write-at-realization; see capturing-golden-rules).")
                fi
            fi
        fi
    fi

    # ---- Check 2: C/C++ static analysis (clang-tidy on changed files) ----
    # Phase 4: invoke clang-tidy if file is C/C++ and prerequisites are in place.
    # Silent skip on anything missing — never pollute agent context with infra errors.
    #
    # Signal fidelity (field-proven failure mode): Homebrew clang-tidy on macOS lacks the
    # SDK sysroot Apple clang implies, so a bare run fails to parse ("'atomic' file not
    # found") and the surviving diagnostics are garbage. We (a) inject the sysroot via
    # xcrun when available, and (b) if the TU still fails to parse (any
    # clang-diagnostic-error), suppress the diagnostics and emit ONE honest line.
    # Residual blind spot: on parse failure only that one line is emitted — quietness is
    # NOT lint-clean (see header note).
    case "$file_path" in
        *.c|*.cc|*.cpp|*.cxx|*.h|*.hpp|*.hh)
            # Need clang-tidy on PATH
            if command -v clang-tidy >/dev/null 2>&1; then
                # Need compile_commands.json — check root, .build/, build/
                cc_dir=""
                for d in "$project_root" "$project_root/.build" "$project_root/build" "$project_root/builddir"; do
                    if [ -f "$d/compile_commands.json" ]; then
                        cc_dir="$d"
                        break
                    fi
                done
                if [ -n "$cc_dir" ]; then
                    # macOS: give Homebrew clang-tidy the SDK sysroot Apple clang implies.
                    sysroot_args=()
                    if [ "$(uname -s)" = "Darwin" ] && command -v xcrun >/dev/null 2>&1; then
                        sdk_path=$(xcrun --show-sdk-path 2>/dev/null || true)
                        if [ -n "$sdk_path" ]; then
                            sysroot_args=(--extra-arg=-isysroot "--extra-arg=$sdk_path")
                        fi
                    fi
                    # 5-second timeout cap (BSD/macOS `timeout` may be `gtimeout`; try both)
                    tidy_cmd="clang-tidy"
                    if command -v timeout >/dev/null 2>&1; then
                        tidy_cmd="timeout 5 clang-tidy"
                    elif command -v gtimeout >/dev/null 2>&1; then
                        tidy_cmd="gtimeout 5 clang-tidy"
                    fi
                    # --quiet suppresses progress; capture warnings only
                    tidy_out=$($tidy_cmd -p "$cc_dir" --quiet ${sysroot_args[@]+"${sysroot_args[@]}"} "$file_path" 2>/dev/null | grep -E '(warning|error):' | head -20 || true)
                    if printf '%s' "$tidy_out" | grep -q 'clang-diagnostic-error'; then
                        # TU failed to parse — its diagnostics are unreliable. One honest line.
                        warnings+=("clang-tidy could not fully parse $(basename "$file_path") (clang-diagnostic-error, e.g. missing SDK/include paths); diagnostics suppressed as unreliable. Verify via the build or the project lint script (see cpp-static-analysis).")
                    elif [ -n "$tidy_out" ]; then
                        # Truncate to ~1500 chars to stay under hook budget
                        if [ "${#tidy_out}" -gt 1500 ]; then
                            tidy_out="${tidy_out:0:1500}
... (truncated; run clang-tidy directly for full output)"
                        fi
                        warnings+=("clang-tidy on $(basename "$file_path"):
$tidy_out
(triage: self-correction-loop · interpretation: cpp-static-analysis)")
                    fi
                fi
            fi
            ;;
    esac

    # ---- C/C++ runtime-check nudge (v0.3.0) ----
    # Bounded: PostToolUse may at most *suggest* /sanitize after a C/C++ change — never run
    # sanitizers inline (they exceed the 5s budget). Rides an existing warning, so it never
    # fires standalone (no per-edit noise).
    case "$file_path" in
        *.c|*.cc|*.cpp|*.cxx|*.h|*.hpp|*.hh)
            if [ "${#warnings[@]}" -gt 0 ]; then
                warnings+=("Runtime check: consider /sanitize (ASan+UBSan) to exercise this C/C++ change under instrumentation.")
            fi
            ;;
    esac

    # ---- Pulse nudge joins the slow lane's warning batch (v0.15.0) ----
    if [ -n "$PULSE_NUDGE" ]; then
        warnings+=("$PULSE_NUDGE")
        printf '%s' "$seq" > "$pulse_root/.harness-anchor/pulse-$session_id.last" 2>/dev/null || true
    fi

    # ---- Emit output ----
    if [ "${#warnings[@]}" -eq 0 ]; then
        return 0
    fi

    # Join warnings with newlines, then escape via the shared engine chain.
    joined=""
    for w in "${warnings[@]}"; do
        if [ -z "$joined" ]; then joined="$w"; else joined="$joined
$w"; fi
    done
    escaped=$(printf '%s' "$joined" | ha_json_escape)

    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PostToolUse",\n    "additionalContext": "<harness-anchor PostToolUse>\\n%s\\n</harness-anchor PostToolUse>"\n  }\n}\n' "$escaped"
}

# ---- R1: Total watchdog (5s cap, tempfile-guarded) ----
# SIGKILL + detached stdio, mirroring hooks/session-start (v0.10.0 lesson, measured
# on macOS bash 3.2): a subshell blocked on `sleep` DEFERS SIGTERM until the sleep
# completes, so the TERM watchdog (a) made every consumer's `wait` burn the full 5s
# window and (b) never actually killed a runaway main; an attached-stdio watchdog
# also holds a command-substitution consumer's pipe open for the same 5s.
OUTPUT_FILE=$(mktemp)
main > "$OUTPUT_FILE" 2>/dev/null &
main_pid=$!

( sleep 5; kill -9 $main_pid 2>/dev/null ) >/dev/null 2>&1 &
watchdog_pid=$!

wait $main_pid 2>/dev/null
main_rc=$?
kill -9 $watchdog_pid 2>/dev/null
wait $watchdog_pid 2>/dev/null

if [ "$main_rc" -eq 0 ] && [ -f "$OUTPUT_FILE" ] && [ -s "$OUTPUT_FILE" ]; then
    cat "$OUTPUT_FILE"
fi
rm -f "$OUTPUT_FILE" "$INPUT_FILE" 2>/dev/null

exit 0
